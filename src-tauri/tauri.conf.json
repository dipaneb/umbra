{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Umbra",
  "version": "0.1.4",
  "identifier": "com.dipaneb.umbra",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Umbra",
        "width": 800,
        "height": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/models/"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBNjUyNTkwQTU1NjNERTYKUldUbVBWYWxrQ1ZsV3JjQ3RpWlVoeVp3MnM4aWt3SEdHbGVEaGVpVk5yZVZDeVkweUMxdkhmQVgK",
      "endpoints": ["https://github.com/dipaneb/umbra/releases/latest/download/latest.json"]
    }
  }
}
